{
	"name": "webmcp-adapter",
	"description": "WordPress Site tools for ChatGPT Work and Codex in the ChatGPT desktop app's built-in browser.",
	"type": "module",
	"private": true,
	"files": [
		"webmcp-adapter.php",
		"uninstall.php",
		"includes",
		"src",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/galatanovidiu/webmcp-adapter.git"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"plugin-zip": "wp-scripts plugin-zip",
		"format": "wp-scripts format",
		"test": "node --test tools/*.test.mjs",
		"test:php": "php tools/activity-contract.test.php && php tools/provider-fixture-contract.test.php",
		"wp-env": "wp-env"
	},
	"devDependencies": {
		"@wordpress/env": "^11.6.0",
		"@wordpress/prettier-config": "^4.45.0",
		"@wordpress/scripts": "^32.2.0"
	},
	"overrides": {
		"prettier": "npm:wp-prettier@^3"
	}
}

{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "7.0.4"
	},
	"steps": [
		{
			"step": "activatePlugin",
			"pluginPath": "webmcp-adapter/webmcp-adapter.php"
		},
		{
			"step": "activatePlugin",
			"pluginPath": "webmcp-provider/webmcp-provider.php"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"webmcp_enable_write_tools": false,
				"webmcp_enable_destructive_tools": false,
				"webmcp_allow_automated_confirmation": true
			}
		}
	]
}
